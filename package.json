{
  "name": "@ssr-themes/root",
  "private": true,
  "workspaces": [
    "ssr-themes",
    "examples/*",
    "landing"
  ],
  "scripts": {
    "prepublish": "bun --filter ssr-themes build",
    "pretest": "bun --filter ssr-themes build",
    "build": "bun --filter ssr-themes build && bun --filter @ssr-themes/* build",
    "start": "bun --filter '*' start",
    "dev": "bun --filter '*' dev",
    "size": "bun --filter ssr-themes size",
    "check-format": "prettier . --check",
    "check-types": "bun --filter '*' check-types",
    "test": "bun --filter '*' test",
    "test:e2e": "bun --filter ssr-themes build && bunx playwright test",
    "clean": "rm -rf node_modules .next dist coverage playwright-report test-results && bun --filter '*' clean",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@rocicorp/prettier-config": "^0.4.0",
    "@size-limit/preset-small-lib": "^12.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "^29.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "size-limit": "^12.0.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xcadams/ssr-themes.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.11"
}

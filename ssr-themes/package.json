{
  "name": "ssr-themes",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/server.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.mjs",
      "require": "./dist/zod.js"
    }
  },
  "scripts": {
    "prepublish": "bun run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "size": "bun run build && size-limit",
    "test": "vitest run tests",
    "clean": "rm -rf dist node_modules"
  },
  "size-limit": [
    {
      "name": "client",
      "path": "dist/index.mjs",
      "import": "{ ThemeProvider, useTheme }"
    }
  ],
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.23.0 || ^4"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xcadams/ssr-themes.git"
  },
  "homepage": "https://ssr-themes.cadams.io/"
}

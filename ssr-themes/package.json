{
  "name": "ssr-themes",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE.md",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.mjs",
      "require": "./dist/zod.js"
    }
  },
  "scripts": {
    "prepublish": "bun run build",
    "build": "svelte-kit sync && vite build && svelte-package -i src/svelte -o dist/svelte",
    "dev": "svelte-kit sync && (vite build --watch & svelte-package -i src/svelte -o dist/svelte --watch)",
    "size": "bun run build && size-limit",
    "test": "vitest run tests",
    "clean": "rm -rf .svelte-kit dist node_modules"
  },
  "size-limit": [
    {
      "name": "react",
      "path": "dist/react.mjs",
      "import": "{ ThemeProvider, useTheme }"
    }
  ],
  "peerDependencies": {
    "react": "^19.2.4",
    "svelte": "^5.0.0",
    "zod": "^3.23.0 || ^4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/package": "^2.5.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "svelte": "^5.40.1",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4",
    "zod": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xcadams/ssr-themes.git"
  },
  "homepage": "https://ssr-themes.cadams.io/"
}
